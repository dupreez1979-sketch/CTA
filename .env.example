# Postgres connection string (Neon / Vercel Postgres)
DATABASE_URL=postgres://user:pass@host/db

# Resend API key + verified sender (see README → Resend setup)
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM="The Children's Theatre Alliance <news@childrenstheatrealliance.com.au>"

# Anthropic API key for AI headlines/summaries
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# Vercel Blob read/write token (for re-hosting post images)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx

# Shared secret the cron job must present (any long random string)
CRON_SECRET=change-me

# Password for /admin (username is "admin")
ADMIN_PASSWORD=change-me

# Public origin of this app (no trailing slash)
APP_URL=https://newsletter.example.org

# The Alliance RSS feed
FEED_URL=https://rss.app/feeds/_VmsmgpgoDUUOVAkD.xml

# A Monday (YYYY-MM-DD) that fortnightly issues send on — fixes the
# alternate-Monday parity
FORTNIGHT_ANCHOR=2026-07-06

# Optional: set to 1 to log sends instead of calling Resend
# SEND_DRY_RUN=1
