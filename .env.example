# Supabase Postgres connection string.
# Supabase dashboard → Connect → "Session pooler" URI (the
# ...pooler.supabase.com:5432 one) — works for both the app and the
# build-time migrations, and is IPv4-friendly.
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres

# Strongly recommended in production: the "Transaction pooler" URI
# (same host, port 6543). The running app prefers this when set; it
# shares the database's small connection pool across many serverless
# instances so busy moments can't hit "max clients reached". Build-time
# migrations keep using DATABASE_URL.
# DATABASE_POOL_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres

# Resend API key + verified sender (see README → Resend setup)
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM="The Children's Theatre Alliance <news@childrenstheatrealliance.com.au>"

# Anthropic API key for AI headlines/summaries
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# Shared secret the scheduled pipeline must present (any long random string)
CRON_SECRET=change-me

# Password for /admin (username is "admin")
ADMIN_PASSWORD=change-me

# Public origin of this app on Netlify (no trailing slash)
APP_URL=https://your-site.netlify.app

# The Alliance RSS feed
FEED_URL=https://rss.app/feeds/_VmsmgpgoDUUOVAkD.xml

# A Monday (YYYY-MM-DD) that fortnightly issues send on — fixes the
# alternate-Monday parity
FORTNIGHT_ANCHOR=2026-07-06

# Optional: max new posts processed per pipeline run (default 10)
# INGEST_MAX_PER_RUN=10

# Optional: max Showcase drafts researched per pipeline run (default 2)
# PRESENTER_RESEARCH_MAX_PER_RUN=2

# Optional: DB connections per serverless instance (default 2)
# DB_POOL_MAX=2

# Optional: set to 1 to log sends instead of calling Resend
# SEND_DRY_RUN=1
